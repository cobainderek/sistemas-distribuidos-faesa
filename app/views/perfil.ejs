<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil &middot; <%= aluno.nome %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="page">
        <header class="page-header">
            <div class="page-header__text">
                <a class="back-link" href="/">&larr; Voltar para a lista</a>
            </div>
            <div class="page-header__actions">
                <a class="btn btn-ghost" href="/editar/<%= aluno.id %>">Editar</a>
                <form method="POST" action="/excluir/<%= aluno.id %>" class="inline-form"
                      onsubmit="return confirm('Excluir <%= aluno.nome %>?')">
                    <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
            </div>
        </header>

        <section class="profile-hero">
            <div class="avatar avatar--lg"
                 style="background: linear-gradient(135deg, <%= aluno.avatar_color %>, <%= escurecerCor(aluno.avatar_color) %>);"
                 aria-hidden="true">
                <%= iniciais(aluno.nome) %>
            </div>
            <h1 class="profile-hero__name"><%= aluno.nome %></h1>
            <p class="profile-hero__course">
                <%= aluno.curso %><% if (aluno.periodo) { %> &middot; <%= aluno.periodo %>º periodo<% } %>
            </p>
            <p class="profile-hero__matricula">Matricula <strong><%= aluno.matricula %></strong></p>
        </section>

        <div class="profile-grid">
            <section class="panel">
                <h2 class="panel__title">Sobre</h2>
                <p class="panel__text"><%= aluno.bio ? aluno.bio : '—' %></p>
            </section>

            <section class="panel">
                <h2 class="panel__title">Contato</h2>
                <ul class="info-list">
                    <li>
                        <span class="info-list__label">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                            Email
                        </span>
                        <span class="info-list__value">
                            <% if (aluno.email) { %>
                                <a href="mailto:<%= aluno.email %>"><%= aluno.email %></a>
                            <% } else { %>—<% } %>
                        </span>
                    </li>
                    <li>
                        <span class="info-list__label">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                            Telefone
                        </span>
                        <span class="info-list__value"><%= aluno.telefone || '—' %></span>
                    </li>
                    <% if (aluno.linkedin) { %>
                        <li>
                            <span class="info-list__label">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                                LinkedIn
                            </span>
                            <span class="info-list__value">
                                <a href="<%= aluno.linkedin %>" target="_blank" rel="noopener"><%= aluno.linkedin %></a>
                            </span>
                        </li>
                    <% } %>
                    <% if (aluno.github) { %>
                        <li>
                            <span class="info-list__label">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                                GitHub
                            </span>
                            <span class="info-list__value">
                                <a href="<%= aluno.github %>" target="_blank" rel="noopener"><%= aluno.github %></a>
                            </span>
                        </li>
                    <% } %>
                </ul>
            </section>

            <section class="panel">
                <h2 class="panel__title">Dados pessoais</h2>
                <ul class="info-list">
                    <li>
                        <span class="info-list__label">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                            Nascimento
                        </span>
                        <span class="info-list__value"><%= dataPtBr(aluno.data_nascimento) || '—' %></span>
                    </li>
                    <li>
                        <span class="info-list__label">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            Cidade / Estado
                        </span>
                        <span class="info-list__value">
                            <% if (aluno.cidade || aluno.estado) { %>
                                <%= aluno.cidade || '—' %><% if (aluno.estado) { %> / <%= aluno.estado %><% } %>
                            <% } else { %>—<% } %>
                        </span>
                    </li>
                </ul>
            </section>

            <section class="panel">
                <h2 class="panel__title">Academico</h2>
                <ul class="info-list">
                    <li>
                        <span class="info-list__label">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                            Periodo
                        </span>
                        <span class="info-list__value"><%= aluno.periodo ? aluno.periodo + 'º' : '—' %></span>
                    </li>
                    <li>
                        <span class="info-list__label">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                            Cadastro
                        </span>
                        <span class="info-list__value"><%= dataHoraPtBr(aluno.criado_em) || '—' %></span>
                    </li>
                </ul>
            </section>
        </div>

        <footer class="page-footer">
            <p>
                Adminer: <a href="http://localhost:8081" target="_blank" rel="noopener">localhost:8081</a>
                &middot;
                Portainer: <a href="http://localhost:9000" target="_blank" rel="noopener">localhost:9000</a>
            </p>
        </footer>
    </div>
</body>
</html>
